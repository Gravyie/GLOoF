# Copy to .env and edit. Nothing here is required for the map/telemetry to work;
# only the alert system needs AWS credentials + recipients.

# --- AWS (SNS) ---------------------------------------------------------------
AWS_REGION=ap-south-1
# Credentials come from the standard boto3 chain (env vars, ~/.aws, IAM role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Either an SNS topic with SMS subscriptions...
# SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:glof-alerts
# ...or a comma-separated list of E.164 numbers for direct publish.
# ALERT_PHONE_NUMBERS=+919800000000,+919811111111

# India requires DLT registration for transactional SMS.
# SNS_ENTITY_ID=
# SNS_TEMPLATE_ID=

# Audiences for the automatic escalation policy (comma-separated E.164).
# OPERATOR_PHONE_NUMBERS=+919800000001
# OFFICIAL_PHONE_NUMBERS=+919800000002,+919800000003
# The replay simulation NEVER sends real SMS unless BOTH of these are set:
#   SIM_LIVE_SMS=true   and   ALERT_DRY_RUN=false
SIM_LIVE_SMS=false

# --- Alert safety ------------------------------------------------------------
# /api/alert is disabled (503) until this is set. Send it as the X-API-Key header.
# ALERT_API_KEY=change-me
# Dry-run is ON by default: the message is built and returned but NOT sent.
ALERT_DRY_RUN=true
ALERT_COOLDOWN_SECONDS=300

# --- Server ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
